{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "{{LIST_NAME}}",
  "description": "{{LIST_DESCRIPTION}}",
  "url": "{{LIST_URL}}",
  "numberOfItems": "{{TOTAL_ITEMS}}",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "item": {
        "@type": "{{ACCOMMODATION_TYPE}}",
        "name": "{{ACCOMMODATION_NAME_1}}",
        "description": "{{ACCOMMODATION_DESCRIPTION_1}}",
        "url": "{{ACCOMMODATION_URL_1}}",
        "image": {
          "@type": "ImageObject",
          "url": "{{ACCOMMODATION_IMAGE_URL_1}}",
          "width": "800",
          "height": "600"
        },
        "occupancy": {
          "@type": "QuantitativeValue",
          "maxValue": "{{MAX_OCCUPANCY_1}}"
        },
        "offers": {
          "@type": "Offer",
          "price": "{{PRICE_FROM_1}}",
          "priceCurrency": "{{CURRENCY_CODE}}",
          "availability": "https://schema.org/InStock"
        }
      }
    },
    {
      "@type": "ListItem",
      "position": 2,
      "item": {
        "@type": "{{ACCOMMODATION_TYPE}}",
        "name": "{{ACCOMMODATION_NAME_2}}",
        "description": "{{ACCOMMODATION_DESCRIPTION_2}}",
        "url": "{{ACCOMMODATION_URL_2}}",
        "image": {
          "@type": "ImageObject",
          "url": "{{ACCOMMODATION_IMAGE_URL_2}}",
          "width": "800",
          "height": "600"
        },
        "occupancy": {
          "@type": "QuantitativeValue",
          "maxValue": "{{MAX_OCCUPANCY_2}}"
        },
        "offers": {
          "@type": "Offer",
          "price": "{{PRICE_FROM_2}}",
          "priceCurrency": "{{CURRENCY_CODE}}",
          "availability": "https://schema.org/InStock"
        }
      }
    }
  ]
}
